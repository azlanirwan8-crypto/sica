# ==========================================
# SICA Mobile Environment Configuration (.env.example)
# Digunakan untuk compile-time define (--dart-define) atau flutter_dotenv
# ==========================================

# Flavor lingkungan: development / staging / production
APP_FLAVOR=development

# URL dasar endpoint API backend SICA (Wajib berawalan https:// pada production, http:// diperbolehkan saat dev lokal)
API_BASE_URL=https://api.sica.ac.id/api/v1

# Package ID aplikasi mobile
APP_PACKAGE_NAME=id.ac.sica.mobile

# Keamanan runtime
ENABLE_ROOT_DETECTION=true
ENABLE_SSL_PINNING=false

# Monitoring & Crash Analytics
SENTRY_DSN=
