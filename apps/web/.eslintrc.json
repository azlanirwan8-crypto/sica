{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "next/core-web-vitals",
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    // AGENTS 3.1: larangan total `any` — lint rule ini WAJIB berstatus error.
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "react/no-unescaped-entities": "off",
    // Diatur oleh App Router: `src/app/layout.tsx` adalah layout akar yang berlaku
    // untuk seluruh halaman, jadi `link` font di sana tidak "single page".
    // Pindah ke `next/font/google` tetap layak (tanpa request eksternal + tanpa
    // FOUC) tetapi itu keputusan tersendiri — lihat UI_UX_DESIGN 11.2.
    "@next/next/no-page-custom-font": "off"
  },
  "overrides": [
    {
      "files": ["src/scripts/**/*.ts"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", "dist/", ".next/", "out/", "coverage/", "*.config.js", "*.config.mjs"]
}
