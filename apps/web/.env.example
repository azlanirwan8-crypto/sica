# ==========================================
# 1. Application & Core Runtime
# ==========================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ==========================================
# 2. Database & In-Memory Redis
# ==========================================
# Koneksi pool via PgBouncer untuk operasional transaksi aplikasi
DATABASE_URL=postgresql://sica_user:sica_password@localhost:6432/sica_db?sslmode=disable
# Koneksi langsung tanpa PgBouncer khusus migrasi DDL Drizzle
DIRECT_DATABASE_URL=postgresql://sica_user:sica_password@localhost:5432/sica_db?sslmode=disable
# Koneksi Redis untuk BullMQ asynchronous workers & distributed lock
REDIS_URL=redis://:redis_password@localhost:6379

# ==========================================
# 3. Cryptography & JWT RS256 Authentication
# ==========================================
# RS256 PEM string (base64 encoded atau escaped newline)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0123456789abcdef\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD0123456789\n-----END PRIVATE KEY-----"
JWT_ACCESS_TOKEN_TTL_SEC=900
JWT_REFRESH_TOKEN_TTL_SEC=604800
PASSWORD_HASH_PEPPER=sica_super_secure_pepper_must_be_at_least_32_characters_long

# ==========================================
# 4. OAuth & Identity Federation (Kampus SSO)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# 5. Payment Gateway Credentials
# ==========================================
MIDTRANS_SERVER_KEY=SB-Mid-server-SampleKey12345
MIDTRANS_CLIENT_KEY=SB-Mid-client-SampleKey12345
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=webhook_secret_min_16_chars_long

# ==========================================
# 6. Messaging Gateway
# ==========================================
FONNTE_WHATSAPP_TOKEN=sample_fonnte_token_12345
RESEND_API_KEY=re_sample_resend_api_key_12345
EMAIL_SENDER_ADDRESS=no-reply@sica.ac.id

# ==========================================
# 7. Object Storage (S3 / Cloudflare R2)
# ==========================================
STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
STORAGE_BUCKET_NAME=sica-storage
STORAGE_ACCESS_KEY_ID=sample_access_key_12345
STORAGE_SECRET_ACCESS_KEY=sample_secret_access_key_1234567890
STORAGE_PUBLIC_CDN_URL=https://cdn.sica.ac.id

# ==========================================
# 8. Public Client Variables (NEXT_PUBLIC_*)
# ==========================================
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="SICA Academic Cloud"
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SENTRY_DSN=
